<Window x:Class="Cleanstrike.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Border Margin="24" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="14"
            Width="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <TextBlock x:Name="TitleText" Style="{StaticResource T.Title}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
            <TextBox x:Name="Input" Margin="0,16,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0" MinWidth="88" IsCancel="True" Click="OnSecondary" />
                <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Primary}" MinWidth="88" IsDefault="True" Click="OnPrimary" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
