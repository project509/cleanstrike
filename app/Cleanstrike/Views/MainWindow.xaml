<Window x:Class="Cleanstrike.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cleanstrike.ViewModels"
        xmlns:v="clr-namespace:Cleanstrike.Views"
        Title="Cleanstrike" Width="1080" Height="700" MinWidth="860" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Font}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Icon="/Assets/cleanstrike.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <v:InverseVisibilityConverter x:Key="NotVis" />
        <v:StatusBrushConverter x:Key="StatusBrush" />
        <v:StatusIconConverter x:Key="StatusIcon" />
        <v:ToastBrushConverter x:Key="ToastBrush" />

        <!-- Brand mark: dark tile with an amber strike -->
        <DataTemplate x:Key="Mark">
            <Image Width="30" Height="30" Source="/Assets/cleanstrike.png" RenderOptions.BitmapScalingMode="HighQuality" />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================================================= title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <ContentPresenter ContentTemplate="{StaticResource Mark}" />
                    <TextBlock Text="Cleanstrike" Style="{StaticResource T.Strong}" FontFamily="{StaticResource FontDisplay}" FontSize="15" Margin="11,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- game chip -->
                    <Button x:Name="GameChip" Style="{StaticResource Btn.Text}" Height="34" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsReady, Converter={StaticResource Vis}}" Click="OnGameChip" ToolTip="{Binding GameDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GameTitle}" Style="{StaticResource T.Base}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource T.Icon}" FontSize="9" Margin="9,1,0,0" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="{Binding GameTitle}" IsEnabled="False" />
                                <MenuItem Header="{Binding LoaderStatus}" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Open game folder" Command="{Binding OpenGameFolderCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open mods folder" Command="{Binding OpenModsFolderCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="View last launch log" Command="{Binding OpenLogCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Use a different game folder…" Command="{Binding LocateGameCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE71E;" FontFamily="{StaticResource Icons}" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Launch through Steam" IsCheckable="False" IsChecked="{Binding LaunchViaSteam, Mode=OneWay}"
                                          Command="{Binding ToggleSteamCommand}" IsEnabled="{Binding CanLaunchViaSteam}" />
                                <MenuItem Header="Close Cleanstrike when the game starts" IsChecked="{Binding CloseOnLaunch, Mode=OneWay}"
                                          Command="{Binding ToggleCloseOnLaunchCommand}" />
                                <Separator />
                                <MenuItem Header="Remove Cleanstrike from the game…" Command="{Binding UninstallCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource Btn.Chrome}" Click="OnMinimize" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" Style="{StaticResource T.Icon}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Btn.Chrome}" Click="OnMaximize">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource T.Icon}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource Btn.ChromeClose}" Click="OnClose" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource T.Icon}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================================================= searching -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding IsSearching, Converter={StaticResource Vis}}">
                <v:Spinner Width="34" Height="34" HorizontalAlignment="Center" />
                <TextBlock Text="Looking for Road to Vostok…" Style="{StaticResource T.Muted}" FontSize="14" Margin="0,18,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ======================================================= needs game -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60" Width="460"
                    Visibility="{Binding NeedsGame, Converter={StaticResource Vis}}">
                <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource Mark}" HorizontalAlignment="Center">
                        <ContentPresenter.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                        </ContentPresenter.LayoutTransform>
                    </ContentPresenter>
                    <TextBlock Text="Where's Road to Vostok?" Style="{StaticResource T.Display}" HorizontalAlignment="Center" Margin="0,26,0,0" />
                    <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0"
                               Text="Cleanstrike couldn't find the game on this PC. Point it to the folder that has the game's .exe. In Steam: right-click Road to Vostok › Manage › Browse local files." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Content="Locate game folder" Height="40" Padding="20,0" Command="{Binding LocateGameCommand}" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Search again" Height="40" Padding="18,0" Margin="10,0,0,0" Command="{Binding SearchAgainCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================= main -->
            <Grid Grid.Row="1" Visibility="{Binding IsReady, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- banner -->
                <Border Grid.ColumnSpan="2" Margin="24,4,24,12" Padding="14,10" CornerRadius="10" Background="{StaticResource AccentSoft}"
                        BorderBrush="#40F2B544" BorderThickness="1" Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Height="26" Width="26" Command="{Binding DismissBannerCommand}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="10" />
                        </Button>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Banner}" Style="{StaticResource T.Body}" Foreground="{StaticResource Text}" />
                    </DockPanel>
                </Border>

                <!-- ============== left: mod list -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="24,4,12,0" />
                            <Style.Triggers>
                                <!-- No mods yet: the drop zone takes the whole width. -->
                                <DataTrigger Binding="{Binding HasMods}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Setter Property="Margin" Value="24,4,24,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Command="{Binding AddModCommand}" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Add mod" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" Style="{StaticResource T.Title}" />
                            <Border Background="{StaticResource Surface2}" CornerRadius="9" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasMods, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Mods.Count}" Style="{StaticResource T.Caption}" Foreground="{StaticResource Muted}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- empty state: dashed drop zone -->
                    <Grid Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding HasMods, Converter={StaticResource NotVis}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource BorderStrong}" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="#06FFFFFF" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                            <TextBlock Text="Drop mods here" Style="{StaticResource T.Strong}" FontSize="16" HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text=".csmod, .vmz or .zip files. Cleanstrike handles the rest." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="Browse for mods" HorizontalAlignment="Center" Margin="0,18,0,0" Command="{Binding AddModCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ModList" Grid.Row="1" ItemsSource="{Binding Mods}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ModListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,16"
                             Visibility="{Binding HasMods, Converter={StaticResource Vis}}"
                             PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                             DragOver="OnListDragOver" Drop="OnListDrop" KeyDown="OnListKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                                <Grid Margin="10,12,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- drag handle -->
                                    <TextBlock x:Name="Grip" Tag="grip" Text="&#xE76F;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Cursor="SizeNS" ToolTip="Drag to change load order" Opacity="0.55" />
                                    <!-- monogram -->
                                    <Border x:Name="Thumb" Grid.Column="1" Width="38" Height="38" CornerRadius="9" Margin="4,0,14,0" Background="#1C1F24" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource T.Strong}" FontFamily="{StaticResource FontDisplay}" FontSize="16"
                                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- thumbnail, when the mod ships one -->
                                            <Border CornerRadius="8" Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Strong}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource T.Caption}" Margin="8,1,0,0" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource PremiumBadge}" Margin="9,1,0,0" Visibility="{Binding IsPremium, Converter={StaticResource Vis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="8.5" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="PREMIUM MOD" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding StatusKind, Converter={StaticResource StatusIcon}}" FontFamily="{StaticResource Icons}" FontSize="11"
                                                       Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" Margin="0,1,6,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource Vis}}" />
                                            <TextBlock x:Name="Sub" Text="{Binding Description}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Toggle}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="14,0,0,0"
                                              ToolTip="Turn this mod on or off" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                        <Setter TargetName="Thumb" Property="BorderBrush" Value="{StaticResource Gold}" />
                                        <Setter TargetName="Thumb" Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasRuleNote}" Value="True">
                                        <Setter TargetName="Sub" Property="Text" Value="{Binding RuleNote}" />
                                        <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                        <Setter TargetName="Sub" Property="Text" Value="{Binding StatusText}" />
                                        <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                        <Setter TargetName="Sub" Property="Text" Value="{Binding Compatibility}" />
                                        <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ============== right: details -->
                <Border Grid.Row="1" Grid.Column="1" Margin="12,4,24,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="14" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel Margin="22,22,18,16" DataContext="{Binding Selected}">
                                <Border Width="220" Height="220" HorizontalAlignment="Left" CornerRadius="12" Margin="0,0,0,18"
                                        Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Style="{StaticResource PremiumBadge}" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="8,3,9,3"
                                        Visibility="{Binding IsPremium, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="PREMIUM MOD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Title}" FontSize="20" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Byline}" Style="{StaticResource T.Muted}" Margin="0,4,0,0" />

                                <!-- why it's held back (a clash or a missing requirement) -->
                                <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="9" Background="{StaticResource AccentSoft}"
                                        Visibility="{Binding HasRuleNote, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding RuleNote}" Style="{StaticResource T.Body}" Foreground="{StaticResource Text}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>

                                <!-- status -->
                                <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="9" Visibility="{Binding HasStatus, Converter={StaticResource Vis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                                    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="{Binding StatusKind, Converter={StaticResource StatusIcon}}" FontFamily="{StaticResource Icons}" FontSize="12"
                                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Body}" Foreground="{StaticResource Text}" FontSize="12.5" LineHeight="18" />
                                    </DockPanel>
                                </Border>
                                <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="9" Background="{StaticResource DangerSoft}"
                                        Visibility="{Binding IsCompatible, Converter={StaticResource NotVis}}">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Danger}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Compatibility}" Style="{StaticResource T.Body}" Foreground="{StaticResource Text}" FontSize="12.5" LineHeight="18" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Margin="0,16,0,0" />

                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,14,0,0" Visibility="{Binding HasTags, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" Style="{StaticResource T.Caption}" Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- settings -->
                                <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                                    <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,16" />
                                    <TextBlock Text="SETTINGS" Style="{StaticResource T.Section}" />
                                    <ItemsControl ItemsSource="{Binding Settings}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SettingViewModel}">
                                                <StackPanel Margin="0,12,0,0">
                                                    <!-- bool -->
                                                    <DockPanel Visibility="{Binding IsBool, Converter={StaticResource Vis}}">
                                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding BoolValue}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <!-- number -->
                                                    <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource Vis}}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NumberText}" Style="{StaticResource T.Base}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" />
                                                        </DockPanel>
                                                        <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding NumberValue}" SmallChange="{Binding Step}"
                                                                LargeChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" LineHeight="16"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <!-- choice -->
                                                    <StackPanel Visibility="{Binding IsChoice, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" />
                                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding TextValue}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <!-- text -->
                                                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" />
                                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Changes apply the next time you press Play." Style="{StaticResource T.Caption}" Margin="0,16,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- detail footer -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.TextDanger}" Command="{Binding RemoveModCommand}" Height="30">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Selected.FileLine}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============== footer -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,14" Background="#0A0B0D">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Text}" Content="Play without mods" Command="{Binding PlayVanillaCommand}" Margin="0,0,10,0" Height="40" />
                            <Button Style="{StaticResource Btn.Play}" Command="{Binding PlayCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Profile" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" MinWidth="150" />
                            <Button Style="{StaticResource Btn.Icon}" Margin="4,0,0,0" ToolTip="Profile options" Click="OnProfileMenu">
                                <TextBlock Text="&#xE712;" Style="{StaticResource T.Icon}" />
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Top">
                                        <MenuItem Header="New profile…" Command="{Binding NewProfileCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Rename…" Command="{Binding RenameProfileCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE8AC;" FontFamily="{StaticResource Icons}" FontSize="12" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete" Command="{Binding DeleteProfileCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="16,0" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ======================================================= drop overlay -->
            <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Margin="40" CornerRadius="18" BorderBrush="{StaticResource Accent}" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="36" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop to install" Style="{StaticResource T.Display}" FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ======================================================= toast -->
            <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,92"
                    Background="{StaticResource Surface2}" BorderBrush="{Binding ToastKind, Converter={StaticResource ToastBrush}}" BorderThickness="1"
                    CornerRadius="10" Padding="16,10" IsHitTestVisible="False" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="8" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding ToastKind, Converter={StaticResource ToastBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ToastText}" Style="{StaticResource T.Base}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
