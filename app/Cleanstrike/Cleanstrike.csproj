<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Cleanstrike</AssemblyName>
    <RootNamespace>Cleanstrike</RootNamespace>
    <ApplicationIcon>Assets\cleanstrike.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Cleanstrike</Product>
    <Company>Cleanstrike</Company>
    <Description>Mod manager for Road to Vostok</Description>
    <Copyright>Cleanstrike</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Portable single exe: dotnet publish -c Release (see tools/publish.ps1) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\loader\cleanstrike_loader.gd" LogicalName="cleanstrike_loader.gd" />
    <!-- Cleanstrike's own mods ship inside the app (built by tools/publish.sh). -->
    <EmbeddedResource Include="../../dist/bundled/*.csmod" LogicalName="bundled/%(Filename)%(Extension)" />
    <Resource Include="Assets\cleanstrike.ico" />
    <Resource Include="Assets\cleanstrike.png" />
  </ItemGroup>

</Project>
