// Cloudflare Workers deploy: serves site/ and the download counter API,
// and attaches the cleanstrike.app domain on every deploy.
{
  "name": "cleanstrike-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "cleanstrike.app", "custom_domain": true },
    { "pattern": "www.cleanstrike.app", "custom_domain": true }
  ]
}
